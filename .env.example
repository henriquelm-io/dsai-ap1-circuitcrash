# Copie para .env e preencha. O .env nunca vai para o Git.
SECRET_KEY=troque-por-uma-frase-longa-e-aleatoria
HOST=127.0.0.1
PORT=8000
# Banco de dados (spec 002). Vazio = dados de exemplo em memória.
# SQLite em arquivo (padrão, não precisa instalar nada):
DATABASE_URL=sqlite:///circuitcrash.db
# PostgreSQL (rode antes: uv sync --extra postgres):
# DATABASE_URL=postgresql://usuario:senha@localhost:5432/circuitcrash
# Login com Google (spec 008). Vazios = o botão "Entrar com Google" não aparece.
# Crie o cliente OAuth no Google Cloud Console (passo a passo no README).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Opcional: fixe o endereço de retorno quando o servidor estiver atrás de um proxy.
# GOOGLE_REDIRECT_URI=https://circuitcrash.onrender.com/auth/google/retorno
